#!/bin/bash
# EC2 の初回起動時に root で 1 回だけ実行されるセットアップスクリプト。
# 実行ログは /var/log/cloud-init-output.log で確認できる。
#
# ※ Terraform の templatefile で読み込むため、"$${...}" と書くと Terraform の変数展開になる。
#    シェル変数は $VAR の形（波かっこなし）で書くこと。
set -euxo pipefail

APP_DIR=/opt/taskboard

# --- タイムゾーン -------------------------------------------------------------
timedatectl set-timezone Asia/Tokyo

# --- スワップ 2GB（t3.micro はメモリ 1GB なので、EC2 上でのビルド用に確保）----
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi

# --- パッケージ ---------------------------------------------------------------
# Java 25（Amazon Corretto 25 の JDK）: バックエンドのビルドと実行
# Node.js 22: フロントエンドのビルド（Vite 8 は Node.js 20.19+ / 22.12+ が必要）
# git: リポジトリの取得 / nginx: 画面の配信と API への中継
dnf install -y \
  java-25-amazon-corretto-devel \
  nodejs22 nodejs22-npm \
  git \
  nginx

# Node.js は node-22 のように名前空間付きで入るので、node / npm コマンドを 22 に向ける
alternatives --set node /usr/bin/node-22

# --- nginx --------------------------------------------------------------------
# 既定のサーバー設定（/usr/share/nginx/html を配信）に、/api/ を Spring Boot へ中継する設定を足す。
# 既定の server ブロックは /etc/nginx/default.d/*.conf を読み込む。
cat > /etc/nginx/default.d/taskboard.conf <<'NGINX'
location /api/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
NGINX

# deploy 時に ec2-user がビルド成果物を置けるようにする
chown -R ec2-user:ec2-user /usr/share/nginx/html

systemctl enable --now nginx

# --- リポジトリの取得 ---------------------------------------------------------
mkdir -p "$APP_DIR"
chown ec2-user:ec2-user "$APP_DIR"
sudo -u ec2-user git clone "${repo_url}" "$APP_DIR"

# --- 確認用にバージョンをログへ出す ---------------------------------------------
java -version
node --version
npm --version
nginx -v
free -h

echo "user_data setup completed"
