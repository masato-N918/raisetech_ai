# このファイルをコピーして .env を作成してください:  cp .env.example .env
# .env は Git にコミットされません（.gitignore 対象）

# データベース名
POSTGRES_DB=taskboard
# DB ユーザー名
POSTGRES_USER=taskboard
# DB パスワード（ローカル開発用。各自の環境で設定してください）
POSTGRES_PASSWORD=change-me-in-local

# Spring Boot がホストから接続する先（コンテナ内では未使用）
DB_HOST=localhost
DB_PORT=5432
